{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${AS_VIP_VERSION}",
	"name": "as_vip",
	"description": "Admin module granting VIP to admins on connection (port of the Pisex admin_system module 'VIP'): the vip.ini 'VIP' block maps admin permissions to vip groups - '@admin/root' holders get the '@admin/root' group, every other admin the group of the first permission he holds - and the grant goes through the vip core's VIP_GiveClientVIP (permanent for the session, no vip_users write). vip.ini is read from configs/admin_system/vip.ini (the Pisex layout) with configs/as_vip/vip.ini as the fallback; the module makes no s2sdk calls. Requires admin_system and vip.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/as_vip",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "admin_system",
			"constraints": ">=1.0.0"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		}
	],
	"methods": []
}
